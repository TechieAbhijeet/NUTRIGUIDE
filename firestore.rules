rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        request.auth.token.email_verified == true;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: Users can read only their own admins/{uid} document; nobody can write from the app
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // User profiles and all private subcollections (/saved, /searches, /plans/{date}, /meals)
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Foods: everyone reads, only admin writes
    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // RatingRules: everyone reads, only admin writes
    match /ratingRules/{ruleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
